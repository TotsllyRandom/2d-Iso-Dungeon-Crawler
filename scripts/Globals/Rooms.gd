func choose_room(doors:Array, type:String, purpose:String = ""):
	var avaliable := []
	
	if not (doors.has(1) or doors.has(2)):
		return 0
	for i in range(len(ROOMS)):
		var check = [
			str(ROOMS[i]["required"][0]) == str(doors[0]) || str(ROOMS[i]["required"][0]) == "X",
			str(ROOMS[i]["required"][1]) == str(doors[1]) || str(ROOMS[i]["required"][1]) == "X",
			str(ROOMS[i]["required"][2]) == str(doors[2]) || str(ROOMS[i]["required"][2]) == "X",
			str(ROOMS[i]["required"][3]) == str(doors[3]) || str(ROOMS[i]["required"][3]) == "X",
			str(ROOMS[i]["type"]) == type,
			]
		if purpose != "":
			check.append((ROOMS[i].get("purpose")==purpose))
		if not check.has(false):
			avaliable.append(i)
	if len(avaliable) == 0:
		return 1
	return avaliable[randi_range(0,len(avaliable)-1)]

func make_room(doors:Array,type:String) -> Array:
	if doors.has(-1):
		return [## top corner
			[" "," "," "," "," "," "," "," "," ",],##right Corner
			[" "," "," "," "," "," "," "," "," ",],
			[" "," "," "," "," "," "," "," "," ",],
			[" "," "," "," "," "," "," "," "," ",],
			[" "," "," "," "," "," "," "," "," ",],
			[" "," "," "," "," "," "," "," "," ",],
			[" "," "," "," "," "," "," "," "," ",],
			[" "," "," "," "," "," "," "," "," ",],
			[" "," "," "," "," "," "," "," "," ",],## bottom Corner
		]
	var ret = get_room_from_hightmap(ROOMS[choose_room(doors,type)]["data"])
	if doors[0]==0:
		ret[4][0] = "W"
	if doors[1] == 0:
		ret[0][4] = "W"
	if doors[2]==0:
		ret[4][8] = "W"
	if doors[3] == 0:
		ret[8][4] = "W"
	return ret

func make_random_heightmap()->Array:
	var ret = []
	for y in range(10):
		var line = []
		for x in range(10):
			if x == 0 or y == 0 or x == 9 or y == 9:
				line.append(-1)
			else:
				line.append(randi_range(0,1))
		ret.append(line)
	return ret
	

func get_room_from_hightmap(map:Array) -> Array:
	var final = []
	for y in range(9):
		var line = []
		for x in range(9):
			var corners = [str(map[y+1][x]),str(map[y][x]),str(map[y][x+1]),str(map[y+1][x+1])]
			if corners.has(" "):
				for corner in range(len(corners)):
					if corners[corner] == " ":
						corners[corner]  = "-1"
			if corners.has("-1"):
				line.append("W")
			else:
				var s = false
				for tile in range(len(TILE_DATA)):
					if TILE_DATA[tile] == [int(corners[0]),int(corners[1]),int(corners[2]),int(corners[3]),]:
						line.append(str(tile))
						s = true
				if !s:
					line.append(0)
		final.append(line)
	return final
